# Production secrets — set these in Vercel / your host. Never commit real values.

EMAILIT_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SUPER_ADMIN_PASSWORD=

# Auth (required on Vercel so sessions survive between instances)
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=https://www.bestl.ink

# Neon / Vercel Postgres — any one of these is enough (app checks them in order).
DATABASE_URL=
POSTGRES_URL=
DATABASE_URL_UNPOOLED=
POSTGRES_URL_NON_POOLING=
POSTGRES_URL_NO_SSL=

# Optional shared redirect cache (Upstash Redis or Vercel KV).
# Without it, each warm function still caches lookups in memory for ~90s.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
